{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/recipe-cms": "~6.2.0@stable",
        "silverstripe/htmleditor-tinymce": "^1.1",
        "symbiote/silverstripe-queuedjobs": "^6.2",
        "symbiote/silverstripe-multivaluefield": "^7.0",
        "symbiote/silverstripe-gridfieldextensions": "^5.2",
        "elliotsawyer/silverstripe-typesense": "^2.0",
        "silverstripe/taxonomy": "^4.2",
        "elliotsawyer/nzstreets": "dev-master",
        "silvershop/silverstripe-hasonefield": "^5.0",
        "silverstripe/login-forms": "^6.2"
    },
    "extra": {
        "expose": [
            "themes/codecamp/dist",
            "search-resene/templates/client",
            "search-geospatial/templates/client",
            "search-audiobooks/templates/client",
            "search-scoped/templates/client"
        ],
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.5.0"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require-dev": {
        "wernerkrauss/silverstripe-rector": "^1.3",
        "cambis/silverstan": "^2.2",
        "phpstan/extension-installer": "^1.4"
    }
}
